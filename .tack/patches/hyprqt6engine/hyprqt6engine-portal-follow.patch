 }
+
+//An explicit theme:color_scheme pins the scheme; otherwise follow the portal's
+//light/dark preference (theme:color_scheme_light / theme:color_scheme_dark).
+QString CHyprPlatformTheme::effectiveColorScheme() const {
+    static auto PCOLORSCHEME = g_pConfigManager->getValue<Hyprlang::STRING>("theme:color_scheme");
+    if (!std::string_view(*PCOLORSCHEME).empty())
+        return QString::fromUtf8(*PCOLORSCHEME);
+    return m_colorSchemePath;
+}
+
+//color-scheme preference: 1 = prefer dark, 2 = prefer light, 0 = no preference
+QString CHyprPlatformTheme::resolveScheme(uint preference) const {
+    static auto PLIGHT = g_pConfigManager->getValue<Hyprlang::STRING>("theme:color_scheme_light");
+    static auto PDARK  = g_pConfigManager->getValue<Hyprlang::STRING>("theme:color_scheme_dark");
+
+    const QString light = QString::fromUtf8(*PLIGHT);
+    const QString dark  = QString::fromUtf8(*PDARK);
+
+    QString path = (preference == 2) ? light : dark;
+    if (path.isEmpty()) //fall back to whichever scheme is configured
+        path = (preference == 2) ? dark : light;
+    return path;
+}
+
+void CHyprPlatformTheme::updateColorScheme(uint preference) {
+    const QString path = resolveScheme(preference);
+    if (path == m_colorSchemePath)
+        return;
+
+    m_colorSchemePath = path;
+    applySettings();
+}
+
+void CHyprPlatformTheme::onColorSchemeChanged(const QString& ns, const QString& key, const QDBusVariant& value) {
+    if (ns == u"org.freedesktop.appearance"_s && key == u"color-scheme"_s)
+        updateColorScheme(value.variant().toUInt());
+}
+
+void CHyprPlatformTheme::watchColorScheme() {
+    auto bus = QDBusConnection::sessionBus();
+
+    bus.connect(u"org.freedesktop.portal.Desktop"_s, u"/org/freedesktop/portal/desktop"_s, u"org.freedesktop.portal.Settings"_s, u"SettingChanged"_s, this,
+                SLOT(onColorSchemeChanged(QString, QString, QDBusVariant)));
+
+    uint             preference = 0;
+    QDBusInterface   iface(u"org.freedesktop.portal.Desktop"_s, u"/org/freedesktop/portal/desktop"_s, u"org.freedesktop.portal.Settings"_s, bus);
+    QDBusReply<QDBusVariant> reply = iface.call(u"ReadOne"_s, u"org.freedesktop.appearance"_s, u"color-scheme"_s);
+    if (reply.isValid())
+        preference = reply.value().variant().toUInt();
+
+    m_colorSchemePath = resolveScheme(preference);
+}
